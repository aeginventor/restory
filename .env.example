# Copy to .env.local. These two values are public browser credentials.
# Database RLS, not a secret browser key, protects each user's records.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# Never add service_role, secret keys, database passwords, or email credentials here.

# Optional: set true to force the browser-only demo even when credentials exist.
NEXT_PUBLIC_DEMO_MODE=false
# Supabase의 Google 제공자를 설정한 뒤 true로 바꾸면 로그인 화면에 Google로 계속하기 버튼이 보입니다.
NEXT_PUBLIC_GOOGLE_LOGIN=false
